{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build ForestSceneVK (CMake)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build_vk_vscode",
        "--target",
        "ForestSceneVK",
        "-j",
        "8"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "windows": {
        "args": [
          "--build",
          "${workspaceFolder}/build_vk_vscode",
          "--target",
          "ForestSceneVK",
          "--config",
          "Debug"
        ]
      }
    }
  ]
}

